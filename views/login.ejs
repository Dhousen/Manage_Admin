<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Admin Performance Management System</title>
    <link rel="stylesheet" href="/public/styles.css" /><script src="/public/app.js" defer></script>
  </head>
  <body class="auth-page">
    <div class="auth-wrap">
      <div class="auth-card">
        <div class="auth-heading">
          <span class="auth-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 17.5 9.2 6l3.1 7 2.2-4.3 5.5 8.8"/><path d="M4 20h16"/></svg>
          </span>
          <h1>Log in</h1>
          <p>Masuk ke akun Anda untuk melanjutkan mengelola performa karyawan.</p>
        </div>
        <% if (error) { %>
          <div class="alert auth-alert" role="alert"><%= error %></div>
        <% } %>
        <form class="auth-form" method="POST" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="auth-input">
            <label class="sr-only" for="username">Username</label>
            <svg class="auth-input-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg>
            <input id="username" name="username" type="text" placeholder="Masukkan username" autocomplete="username" required />
          </div>
          <div class="auth-input">
            <label class="sr-only" for="password">Password</label>
            <svg class="auth-input-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 1 1 8 0v3"/><path d="M12 14v3"/></svg>
            <input id="password" name="password" type="password" placeholder="Masukkan password" autocomplete="current-password" required />
            <button class="password-toggle" type="button" data-password-toggle aria-label="Tampilkan password" aria-pressed="false">
              <svg class="password-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="password-eye-off" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18"/><path d="M10.6 6.2A11 11 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-3.1 3.6M6.2 6.2C3.5 8 2 12 2 12s3.5 6 10 6c1 0 2-.2 2.8-.5"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
            </button>
          </div>
          <button class="btn btn-primary auth-submit" type="submit">
            <span>Log in</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </button>
        </form>
        <div class="auth-footer">
          <span class="auth-footer-line"></span>
          <p>Gunakan akun pengelola yang telah terdaftar.</p>
          <span class="auth-footer-line"></span>
        </div>
      </div>
    </div>
  </body>
</html>
