<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> | APMS</title>
    <link rel="stylesheet" href="/public/styles.css" /><script src="/public/app.js" defer></script>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <ul class="nav-list">
          <li class="nav-item"><a href="/dashboard">Dashboard</a></li>
          <li class="nav-item"><a href="/admins">Data Karyawan</a></li>
          <li class="nav-item"><a class="active" href="/performance">Kinerja Harian</a></li>
          <li class="nav-item"><a href="/audit">Audit Kinerja</a></li>
          <li class="nav-item"><a href="/reports">Laporan Bulanan</a></li>
          <li class="nav-item"><a href="/jobdesk">Manajemen Jobdesk</a></li>
          <li class="nav-item"><a href="/history">Riwayat Perubahan</a></li>
          <li class="nav-item"><a href="/export">Export Google Sheets</a></li>
          <li class="nav-item"><a href="/settings">Pengaturan Akun</a></li>
          <li class="nav-item"><a href="/logout">Logout</a></li>
        </ul>
      </aside>
      <main class="content">
        <div class="topbar">
          <div><div class="muted">Halo, <%= user.full_name %></div><strong><%= user.role %></strong></div>
          <div class="user-meta">Monitoring Kinerja Harian</div>
        </div>
        <h1 class="page-title">Kinerja Harian</h1>

        <div class="filter-bar">
          <form method="GET" action="/performance">
            <div class="filter-grid">
              <div class="form-field">
                <label>Tanggal</label>
                <input type="date" name="date" value="<%= filters.date %>" onchange="this.form.submit()" />
              </div>
              <div class="form-field">
                <label>Bulan</label>
                <input type="number" name="month" value="<%= filters.month %>" min="1" max="12" onchange="this.form.submit()" />
              </div>
              <div class="form-field">
                <label>Tahun</label>
                <input type="number" name="year" value="<%= filters.year %>" onchange="this.form.submit()" />
              </div>
              <div class="form-field">
                <label>Nama Karyawan</label>
                <select name="adminId" onchange="this.form.submit()">
                  <option value="">Semua</option>
                  <% adminOptions.forEach((admin) => { %>
                    <option value="<%= admin.id %>" <%= String(filters.adminId) === String(admin.id) ? 'selected' : '' %>><%= admin.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-field">
                <label>Status</label>
                <select name="status" onchange="this.form.submit()">
                  <option value="">Semua</option>
                  <% statusOptions.forEach((status) => { %>
                    <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option>
                  <% }) %>
                </select>
              </div>
            </div>
          </form>
        </div>

        <div class="btn-row">
          <a class="btn btn-primary" href="/performance/new">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            <span>Tambah Data</span>
          </a>
        </div>

        <div class="panel" style="margin-top:18px;">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tanggal</th>
                  <th>Admin</th>
                  <th>Nama Tugas</th>
                  <th>Status</th>
                  <th>Pencapaian</th>
                  <th>KPI</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% entries.forEach((entry) => { %>
                  <tr>
                    <td><%= entry.entry_date %></td>
                    <td><%= entry.admin_name %></td>
                    <td><%= entry.job_name %></td>
                    <td>
                      <span class="status-badge status-<%= entry.status === 'Selesai' ? 'selesai' : entry.status === 'Proses' ? 'proses' : entry.status === 'Terlambat' ? 'terlambat' : entry.status === 'Belum Selesai' ? 'belum' : 'tidak' %>"><%= entry.status %></span>
                    </td>
                    <td><%= entry.percentage || 0 %>%</td>
                    <td><%= entry.kpi_score || 0 %></td>
                    <td>
                      <div class="btn-row" style="margin-top:0; gap:8px;">
                        <a href="/performance/<%= entry.id %>/detail" class="action-btn" title="Detail" aria-label="Detail">
                          <svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                        <a href="/performance/<%= entry.id %>/edit" class="action-btn" title="Edit" aria-label="Edit">
                          <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/></svg>
                        </a>
                        <% if (isOwner) { %>
                        <form action="/performance/delete/<%= entry.id %>" method="POST" style="display:inline;">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button class="action-btn delete" type="submit" title="Hapus" aria-label="Hapus">
                            <svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                          </button>
                        </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
